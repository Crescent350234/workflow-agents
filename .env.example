# 真实 LLM 接入配置（运行 `python run.py --task "..."` 时读取）
# 复制本文件为 .env 并填入你的 Key 即可。

# 兼容 OpenAI 的接口地址（OpenAI / 通义千问 DashScope / DeepSeek 等均可）
LLM_BASE_URL=https://api.openai.com/v1

# 你的 API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名（如 gpt-4o-mini / qwen-plus / deepseek-chat）
LLM_MODEL=gpt-4o-mini

# 是否强制演示模式：1=强制 Mock（无需 Key，但只返回占位回答）；0=使用真实 LLM
MOCK_MODE=0
